# nuxt-auth-utils 0.6+ seals the session with this (openssl rand -base64 32)
NUXT_APP_SECRET=change-me-to-a-random-32-plus-character-string
# Optional overrides. The playground ships dev-only defaults for both, signed with the public dev secret.
# NUXT_POSTGREST_JWT_SECRET=nuxt-postgrest-dev-secret-at-least-32-chars-long
# NUXT_POSTGREST_SECRET_KEY=   # service_role JWT: node scripts/dev-jwt.mjs service_role
