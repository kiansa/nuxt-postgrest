{
  "name": "nuxt-postgrest",
  "version": "0.1.0",
  "description": "First-class PostgREST for Nuxt: typed clients, SSR-aware composables and auth-aware JWT forwarding. No Supabase required.",
  "repository": "kiansa/nuxt-postgrest",
  "homepage": "https://kiansa.github.io/nuxt-postgrest/",
  "bugs": "https://github.com/kiansa/nuxt-postgrest/issues",
  "license": "MIT",
  "author": "Kian",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "postgrest",
    "postgres",
    "postgresql",
    "rest",
    "database"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "bin": {
    "nuxt-postgrest": "./bin/nuxt-postgrest.mjs"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground --port 3000",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.postgrest.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.postgrest.yml down -v",
    "pretest": "nuxt prepare test/fixtures/basic",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs generate",
    "release": "pnpm dev:prepare && pnpm lint && pnpm test && pnpm test:types && pnpm prepack && changelogen --release --push",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest watch",
    "test:types": "pnpm dev:prepare && nuxt prepare test/fixtures/basic && pnpm typecheck:project playground test/fixtures/basic",
    "typecheck:project": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@supabase/postgrest-js": "^2.118.0",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "h3": "^1.15.4",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
